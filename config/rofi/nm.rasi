/* macOS-style minimal menu for wifi (networkmanager-dmenu) */
configuration {
    show-icons: false;
    display-drun: " ";
    disable-history: true;
}

window {
    width: 340px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background-color: rgba(24, 24, 30, 0.88);
    location: northeast;
    anchor: northeast;
    y-offset: 32px;
    x-offset: -8px;
    padding: 8px;
    text-color: #ffffff;
}

listview {
    lines: 10;
    columns: 1;
    scrollbar: false;
    spacing: 4px;
    padding: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 10px;
    background-color: transparent;
    text-color: #ffffff;
    font: "JetBrainsMono Nerd Font 13";
}

element selected {
    background-color: rgba(255, 255, 255, 0.16);
}

element normal.urgent,
element urgent {
    text-color: #ff6b6b;
}

entry {
    padding: 8px 12px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    text-color: #ffffff;
    font: "JetBrainsMono Nerd Font 13";
}

mainbox {
    margin: 0px;
    padding: 0px;
    background-color: transparent;
}
